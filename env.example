# =====================================================
# ARABIAN EAGLE AEC GATEWAY - ENVIRONMENT VARIABLES
# =====================================================
# لا تضع قيماً حقيقية هنا، هذا مجرد نموذج.
# انسخ إلى .env واملأ القيم الفعلية في بيئة الإنتاج.

# -------------------- SERVER --------------------
PORT=3000
NODE_ENV=testnet   # development | testnet | production

# -------------------- CORS --------------------
CORS_ORIGIN=https://your-pi-app-domain.com

# -------------------- SERVICE URLs --------------------
# (تنتهي بـ /api لأن الخدمات تقدم health على /api/health)
BIGISH_YER_URL=http://localhost:3001/api
GAV_URL=NOT_CONFIGURED
AJYAL_URL=NOT_CONFIGURED
AUCTION_URL=NOT_CONFIGURED
COBRA_URL=NOT_CONFIGURED
AMAN_URL=NOT_CONFIGURED
BEWELL_URL=NOT_CONFIGURED
TELCOM_URL=NOT_CONFIGURED
AECFUND_URL=NOT_CONFIGURED

# -------------------- HEALTH CHECK TIMEOUT (ms) --------------------
HEALTH_TIMEOUT=5000

# -------------------- Pi NETWORK (Foundation Only) --------------------
PI_API_KEY=NOT_CONFIGURED
PI_SANDBOX=true