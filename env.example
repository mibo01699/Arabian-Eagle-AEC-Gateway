# =====================================================
# ARABIAN EAGLE AEC GATEWAY - ENVIRONMENT VARIABLES
# =====================================================
# لا تضع أي قيم حقيقية هنا، هذا مجرد نموذج.
# انسخ هذا الملف إلى .env واملأ القيم الفعلية.

# -------------------- SERVER --------------------
PORT=3000
NODE_ENV=development   # testnet | production

# -------------------- CORS --------------------
# النطاق المسموح به للطلبات (افترض Pi Browser domain)
CORS_ORIGIN=http://localhost:3000

# -------------------- SERVICE URLs --------------------
# عناوين الخدمات المسجلة في البوابة
# يجب أن تنتهي بـ /api (كما هو متوقع في health check)
BIGISH_YER_URL=http://localhost:3001/api
GAV_URL=NOT_CONFIGURED
AJYAL_URL=NOT_CONFIGURED
AUCTION_URL=NOT_CONFIGURED
COBRA_URL=NOT_CONFIGURED
AMAN_URL=NOT_CONFIGURED
BEWELL_URL=NOT_CONFIGURED
TELCOM_URL=NOT_CONFIGURED
AECFUND_URL=NOT_CONFIGURED

# -------------------- HEALTH CHECK TIMEOUT (ms) --------------------
HEALTH_TIMEOUT=5000

# -------------------- Pi NETWORK (Foundation Only) --------------------
# لا تضع مفاتيح حقيقية هنا، استخدم متغيرات البيئة في الإنتاج
PI_API_KEY=NOT_CONFIGURED
PI_SANDBOX=true