# ============================================
# AEC Gateway Environment Variables
# ============================================

# بيئة التشغيل: development | testnet | mainnet
NODE_ENV=testnet

# رابط خدمة BIGISH-YER (يُضبط بعد نشر BIGISH-YER)
BIGISH_YER_URL=

# CORS (يُضبط حسب البيئة)
CORS_ORIGIN=*

# مهلة فحص الصحة بالمللي ثانية
HEALTH_TIMEOUT=3000

# المنفذ المحلي
PORT=3314